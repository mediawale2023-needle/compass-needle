{
  "name": "needle-monorepo",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:mp\" \"npm run dev:admin\"",
    "dev:backend": "venv/bin/python -m uvicorn main:app --reload --port 8000",
    "dev:mp": "npm run dev --prefix frontend -- --port 3000",
    "dev:admin": "npm run dev --prefix admin -- --port 3001",
    "build:mp": "npm run build --prefix frontend",
    "build:admin": "npm run build --prefix admin",
    "test:backend": "venv/bin/python -m pytest tests/"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  }
}
