api.theneedle.in {
	# Govt Department Sync live-portal sessions (WebSocket + REST) must all
	# land on the single-worker backend_govt_live service — see
	# docker-compose.yml for why. Everything else goes to the normal
	# multi-worker backend.
	#
	# Karnataka/Maharashtra interactive status-check attempts
	# (/status-check/start, /status-check/{attempt_id}/advance) used to be
	# routed here too, for the same single-worker-affinity reason: their
	# attempt state used to live in a process-local dict
	# (karnataka_ipgrs.py / maharashtra_aaplesarkar.py _attempts), and a
	# start() and its following advance() landing on different backend
	# workers would report a spurious "expired or not found". Commit
	# c49371e6 moved that state into PostgreSQL
	# (govt_status_check_attempts, via modules/govt_sync/status_attempts.py)
	# specifically so any worker can read/write any attempt — the two
	# patterns were removed from this matcher accordingly and now fall
	# through to the plain multi-worker `backend` below like every other
	# non-live-browser govt-sync route. Tamil Nadu's live status-check
	# (start-status-check, tamil-nadu/check-status, the /stream WebSocket)
	# still opens a real Playwright page via browser_session.py and keeps
	# its single-worker affinity requirement — those routes are unaffected.
	#
	# Two separate, literal-anchored patterns on purpose, not one trailing
	# wildcard: Caddy's path matcher `*` only spans one path segment, never
	# crosses a `/`. Getting this wrong for a multi-segment route pair
	# (see the govt/session patterns below) is worse than leaving it
	# unfixed — confirmed by sending real request paths through a real
	# Caddy instance against dummy upstreams before writing any of this.
	#
	# Every govt/session action gets its own literal-anchored pattern for
	# the SAME reason, discovered later (production-readiness review,
	# 2026-08-26): a Caddy pattern with two or more wildcards forces EVERY
	# wildcard in it — including a trailing one — to match exactly one path
	# segment, not "the rest of the path". The old
	# `/api/cases/*/govt/session/*` (two wildcards) therefore covered
	# .../session/start but silently missed .../session/{id}/close and
	# .../session/{id}/capture-reference (each needs the second wildcard to
	# match just the id, with a literal action after it — impossible for a
	# *trailing* wildcard in a two-wildcard pattern). Confirmed by three
	# real Caddy + dummy-upstream tests: a lone trailing wildcard spans
	# multiple segments (/foo/* matches /foo/x/y/z), but adding a second
	# wildcard anywhere in the same pattern collapses all of them back to
	# single-segment. /api/govt/sessions(/close-all) also never matched at
	# all — the old pattern's literal segment was "session" (singular), the
	# real routes are "sessions" (plural). Every pattern below is written
	# for the exact real route it targets, none relying on a wildcard
	# spanning more than the one segment it's meant to.
	#
	# Tamil Nadu status-check live session (2026-09-02): the same class of
	# gap recurred when these two routes shipped without being added here —
	# start-status-check fell through to the plain multi-worker `backend`
	# below, so the Playwright session it opened lived in a process the
	# @govt_live-routed /stream WebSocket (correctly sent to
	# backend_govt_live) could never see, and the live browser view hung on
	# "Connecting..." forever instead of showing the portal. Every new
	# govt/session route must be added here, not just the WebSocket one.
	#
	# Tamil Nadu HTTP-migration diagnostic (2026-09-07, disabled by default
	# via GOVT_SYNC_TN_HTTP_DIAGNOSTIC_ENABLED — see
	# modules/govt_sync/status/tn_network_diagnostic.py): reads the SAME
	# process-local LiveSession the routes above depend on, so it needs the
	# same single-worker affinity. Two wildcards (case_id, session_id) with
	# literal segments after both — per the wildcard rule documented above,
	# each matches exactly one path segment, so this pattern matches only
	# this exact diagnostic route, nothing broader.
	#
	# Tamil Nadu HTTP-diagnostic runtime gate (2026-09-07, see
	# modules/govt_sync/status/tn_diagnostic_runtime_gate.py): a process-
	# local, single-use permission the diagnostic route above can be run
	# under without recreating backend_govt_live. The grant it creates
	# must live in the SAME process as the LiveSession it's scoped to, so
	# this arm/disarm route needs the identical single-worker affinity —
	# same two-wildcards-with-literal-segments-after-both shape as every
	# other route on this line.
	#
	# Tamil Nadu HTTP-diagnostic, case-scoped invocation (2026-09-07, see
	# api_router.py's govt_tamil_nadu_diagnostic_run_for_case and
	# browser_session.find_live_session_for_case): resolves the LiveSession
	# internally from tenant_id+case_id so the raw session_id never needs
	# to appear in a URL at all — this route has no session_id segment,
	# only case_id. It still reads the SAME process-local LiveSession the
	# routes above depend on, so it needs the same single-worker affinity.
	# Only ONE wildcard in this pattern (case_id), followed entirely by
	# literal segments — per the wildcard rule documented above, a single,
	# non-trailing wildcard already matches exactly one path segment on
	# its own, the same shape as the existing
	# /api/cases/*/govt/session/start pattern already proves works.
	#
	# Tamil Nadu HTTP-diagnostic, Phase 2 multi-ticket/durability (2026-09-08,
	# see api_router.py's govt_tamil_nadu_http_replay_diagnostic_phase2 and
	# modules/govt_sync/status/tn_http_replay_diagnostic.py): same
	# case-scoped, session_id-free shape as the Phase 1 route immediately
	# above (one non-trailing wildcard, case_id only) — needs the identical
	# single-worker affinity since it re-exports cookies from the SAME
	# process-local LiveSession.context, never creating a new one.
	@govt_live path /api/cases/*/govt/session/start /api/cases/*/govt/session/start-status-check /api/cases/*/govt/session/*/capture-reference /api/cases/*/govt/session/*/close /api/cases/*/govt/session/*/tamil-nadu/check-status /api/cases/*/govt/session/*/tamil-nadu/promote-session /api/cases/*/govt/session/*/tamil-nadu/diagnostic/http-replay-proof /api/cases/*/govt/session/*/tamil-nadu/diagnostic/arm /api/cases/*/govt/tamil-nadu/diagnostic/run /api/cases/*/govt/tamil-nadu/http-replay-diagnostic /api/govt/session/*/stream /api/govt/sessions /api/govt/sessions/close-all /api/govt/sessions/*/close
	reverse_proxy @govt_live backend_govt_live:8000

	reverse_proxy backend:8000
}
