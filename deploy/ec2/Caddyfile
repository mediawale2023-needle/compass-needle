api.theneedle.in {
	# Govt Department Sync live-portal sessions (WebSocket + REST) must all
	# land on the single-worker backend_govt_live service — see
	# docker-compose.yml for why. Everything else goes to the normal
	# multi-worker backend.
	#
	# Interactive status-check attempts (Karnataka/Maharashtra CAPTCHA/OTP
	# flows) need the same single-worker affinity: their attempt state lives
	# in a process-local dict (karnataka_ipgrs.py / maharashtra_aaplesarkar.py
	# _attempts), and backend runs 2 workers — a start() and its following
	# advance() could otherwise land on different processes and report a
	# spurious "expired or not found" (confirmed via code trace, resilience
	# review section J1/J2; fixation plan Step 4).
	#
	# Two separate, literal-anchored patterns on purpose, not one trailing
	# wildcard: Caddy's path matcher `*` only spans one path segment, never
	# crosses a `/`. A single `.../status-check/*` matches the 6-segment
	# start route but NOT the 7-segment advance route
	# (.../status-check/{attempt_id}/advance) — confirmed by sending real
	# request paths through a real Caddy instance against dummy upstreams
	# before writing this. Getting this wrong is worse than leaving it
	# unfixed: start() would land on backend_govt_live while advance()
	# stayed on backend's 2-worker pool, which never created the attempt —
	# a 100% failure rate instead of the original ~50% one.
	#
	# Every govt/session action gets its own literal-anchored pattern for
	# the SAME reason, discovered later (production-readiness review,
	# 2026-08-26): a Caddy pattern with two or more wildcards forces EVERY
	# wildcard in it — including a trailing one — to match exactly one path
	# segment, not "the rest of the path". The old
	# `/api/cases/*/govt/session/*` (two wildcards) therefore covered
	# .../session/start but silently missed .../session/{id}/close and
	# .../session/{id}/capture-reference (each needs the second wildcard to
	# match just the id, with a literal action after it — impossible for a
	# *trailing* wildcard in a two-wildcard pattern). Confirmed by three
	# real Caddy + dummy-upstream tests: a lone trailing wildcard spans
	# multiple segments (/foo/* matches /foo/x/y/z), but adding a second
	# wildcard anywhere in the same pattern collapses all of them back to
	# single-segment. /api/govt/sessions(/close-all) also never matched at
	# all — the old pattern's literal segment was "session" (singular), the
	# real routes are "sessions" (plural). Every pattern below is written
	# for the exact real route it targets, none relying on a wildcard
	# spanning more than the one segment it's meant to.
	#
	# Tamil Nadu status-check live session (2026-09-02): the same class of
	# gap recurred when these two routes shipped without being added here —
	# start-status-check fell through to the plain multi-worker `backend`
	# below, so the Playwright session it opened lived in a process the
	# @govt_live-routed /stream WebSocket (correctly sent to
	# backend_govt_live) could never see, and the live browser view hung on
	# "Connecting..." forever instead of showing the portal. Every new
	# govt/session route must be added here, not just the WebSocket one.
	@govt_live path /api/cases/*/govt/session/start /api/cases/*/govt/session/start-status-check /api/cases/*/govt/session/*/capture-reference /api/cases/*/govt/session/*/close /api/cases/*/govt/session/*/tamil-nadu/check-status /api/govt/session/*/stream /api/govt/sessions /api/govt/sessions/close-all /api/govt/sessions/*/close /api/cases/*/govt/status-check/start /api/cases/*/govt/status-check/*/advance
	reverse_proxy @govt_live backend_govt_live:8000

	reverse_proxy backend:8000
}
