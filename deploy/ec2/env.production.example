ENV=production
PORT=8000

# EC2 production uses the Docker Compose postgres service as source of truth.
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/needle

JWT_SECRET=replace-with-32-plus-character-secret
OPENAI_API_KEY=replace-me
GEMINI_API_KEY=replace-me

WHATSAPP_PHONE_NUMBER_ID=replace-me
META_ACCESS_TOKEN=replace-me
META_VERIFY_TOKEN=replace-me
META_APP_SECRET=replace-me

# After Vercel projects are deployed, set both production URLs here.
ALLOWED_ORIGINS=https://your-mp-frontend.vercel.app,https://your-admin-frontend.vercel.app

# Optional
LOG_LEVEL=INFO
SENTRY_DSN=

# Govt Department Sync — live browser sessions (modules/govt_sync/browser_session.py).
# Defaults shown are sane for a small EC2 instance; raise GOVT_SYNC_MAX_LIVE_SESSIONS
# only if the box has the RAM for more concurrent headless Chromium sessions (~300-400MB each).
GOVT_SYNC_MAX_LIVE_SESSIONS=3
GOVT_SYNC_SESSION_IDLE_SECONDS=600
GOVT_SYNC_NO_SANDBOX=1
