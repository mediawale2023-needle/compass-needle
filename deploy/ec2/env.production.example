ENV=production
PORT=8000

# Keep this pointed at Railway Postgres for phase 1, then switch when DB moves.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

JWT_SECRET=replace-with-32-plus-character-secret
OPENAI_API_KEY=replace-me
GEMINI_API_KEY=replace-me

WHATSAPP_PHONE_NUMBER_ID=replace-me
META_ACCESS_TOKEN=replace-me
META_VERIFY_TOKEN=replace-me
META_APP_SECRET=replace-me

# After Vercel projects are deployed, set both production URLs here.
ALLOWED_ORIGINS=https://your-mp-frontend.vercel.app,https://your-admin-frontend.vercel.app

# Optional
LOG_LEVEL=INFO
SENTRY_DSN=
