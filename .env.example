# ============================================
# SECURITY: DO NOT COMMIT REAL VALUES TO GIT
# ============================================
# Copy this file to .env and fill in real values.
# .env is in .gitignore and must NEVER be committed.

# ============================================
# ENVIRONMENT
# ============================================
ENV=production

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Min 32 chars, random, never share. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-jwt-secret-min-32-chars-required

# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://compass-needle-production.up.railway.app,https://admin-production.up.railway.app
ALLOWED_ORIGINS=https://compass-needle-production.up.railway.app,https://admin-production.up.railway.app

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://user:password@host:port/database

# ============================================
# AI API KEYS
# ============================================
# OpenAI — used for grievance classification (GPT-4o-mini)
OPENAI_API_KEY=sk-proj-your-key-here

# Google Gemini — used for letter drafting and letterbox OCR
GEMINI_API_KEY=AIza-your-key-here

# ============================================
# META WHATSAPP CLOUD API
# ============================================
# Get from Meta Business Suite → App Settings → WhatsApp → Phone Numbers
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-here

# System User permanent token (NOT page access token — that expires!)
# Generate at Meta Business Suite → System Users → Generate Token
META_ACCESS_TOKEN=your-permanent-system-user-token-here

# Webhook verify token — any random string you choose
META_VERIFY_TOKEN=your-random-verify-token-here

# App Secret — from Meta App Dashboard → App Settings → Basic → App Secret
META_APP_SECRET=your-app-secret-here

# ============================================
# FRONTEND
# ============================================
NEXT_PUBLIC_API_URL=https://your-backend-url.railway.app

# ============================================
# MONITORING (optional but recommended for pilot)
# ============================================
# Sentry error tracking — create free project at sentry.io
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=INFO
